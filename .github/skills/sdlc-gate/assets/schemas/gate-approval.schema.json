{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hve4isd/schemas/gate-approval.schema.json",
  "title": "SDLC Gate Approval Record",
  "type": "object",
  "required": ["project", "gate", "decision", "approved_by", "approved_at", "evidence", "session_id"],
  "properties": {
    "project": { "type": "string" },
    "gate": { "type": "string", "enum": ["design", "plan", "pr", "release", "production"] },
    "decision": { "type": "string", "enum": ["approved", "approved_with_conditions", "rejected"] },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string" },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "path"],
        "properties": {
          "artifact": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "session_id": { "type": "string", "description": "Audit session in which the evidence was presented and the decision stated" },
    "notes": { "type": "string" }
  }
}
